{
  "name": "dsh-vision-delegation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness Web GUI plugin: pasted images become file attachments, so a text-only main model delegates image inspection to its own vision tool (e.g. glm-5.3-flash) instead of rejecting the message.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "keywords": ["dsh", "deepseek-harness", "vision", "plugin", "bundle"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
